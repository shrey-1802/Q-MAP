# Q-MAP Environment Configuration Template
# Never place private backend secrets (JWT secrets, database passwords, private keys) in frontend env files.

# API Base URL for QIGA Optimization Backend
VITE_API_BASE_URL=http://localhost:8000

# Application Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Map Tile Provider: 'osm' | 'carto_dark' | 'carto_light' | 'custom'
VITE_MAP_PROVIDER=carto_dark

# Public Map Tile URL (default OpenStreetMap/Carto tiles for GIS map view)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Demo/Mock Fallback Mode (MUST BE FALSE IN PRODUCTION)
VITE_ENABLE_DEMO_MODE=false

# Real-time connection transport: 'sse' | 'ws' | 'polling'
VITE_REALTIME_TRANSPORT=polling

# Application Title
VITE_APP_NAME="Q-MAP Intelligent Route Optimization"
